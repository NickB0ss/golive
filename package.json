{
  "name": "golive-lan",
  "version": "0.7.0",
  "description": "Compartilhamento de tela 1080p60 na LAN virtual (Radmin VPN / Tailscale)",
  "main": "src/main.js",
  "author": "Nicolas <nicolasmateusdecastrosilva@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickB0ss/golive"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/signaling.js",
    "dist": "electron-builder --win",
    "test": "node --test",
    "lint": "eslint .",
    "build:native": "node-gyp configure && node scripts/patch-clangcl-toolset.js && node-gyp build"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "node-gyp": "^11.5.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-addon-api": "^8.9.2",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.golive.lan",
    "productName": "GoLive LAN",
    "publish": [
      {
        "provider": "github",
        "owner": "NickB0ss",
        "repo": "golive"
      }
    ],
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "server/**/*",
      "!server/**/*.test.js",
      "build/Release/golive_audio.node",
      "package.json"
    ],
    "asarUnpack": [
      "build/Release/golive_audio.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "GoLive LAN"
    }
  }
}
