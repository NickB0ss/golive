{
  "name": "golive-lan",
  "version": "0.26.0",
  "description": "Compartilhamento de tela 1080p60 na LAN virtual (Radmin VPN / Tailscale)",
  "main": "src/main.js",
  "author": "Nicolas <nicolasmateusdecastrosilva@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickB0ss/golive"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/signaling.js",
    "dist": "electron-builder --win",
    "test": "node --test",
    "lint": "eslint .",
    "env:check": "node scripts/check-environment.js",
    "build:native": "node-gyp configure && node scripts/patch-clangcl-toolset.js && node-gyp build",
    "release:check": "node scripts/check-release.js",
    "lab": "node tools/lab/run.js",
    "bench:media": "node tools/media-bench/run.js",
    "bench:media:quick": "node tools/media-bench/run.js --quick",
    "smoke:app": "node scripts/smoke-app.js",
    "smoke:unpacked": "node scripts/smoke-app.js --exe=\"dist/win-unpacked/GoLive LAN.exe\""
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "node-gyp": "^11.5.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-addon-api": "^8.9.2",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.golive.lan",
    "productName": "GoLive LAN",
    "artifactName": "GoLive-LAN-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "NickB0ss",
        "repo": "golive"
      }
    ],
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "server/**/*",
      "!server/**/*.test.js",
      "build/Release/golive_audio.node",
      "package.json"
    ],
    "asarUnpack": [
      "build/Release/golive_audio.node"
    ],
    "beforeBuild": "./scripts/check-native-build.js",
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "GoLive LAN"
    }
  }
}
